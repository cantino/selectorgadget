{
  "name": "SelectorGadget",

  // Build from our Dockerfile (no devcontainer features; see .devcontainer/README.md)
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  "mounts": [
    // Gems stay in a Docker volume, off the host filesystem
    "source=selectorgadget-bundle,target=/usr/local/bundle,type=volume",
    // Persist JetBrains IDE backend configuration (RubyMine, WebStorm)
    "source=selectorgadget-jetbrains-config,target=/home/vscode/.config/JetBrains,type=volume",
    // Protect .git, I only use it on the host
    "source=${localWorkspaceFolder}/.git,target=${containerWorkspaceFolder}/.git,type=bind,readonly",
    // Protect .devcontainer, it can have an initializeCommand
    "source=${localWorkspaceFolder}/.devcontainer,target=${containerWorkspaceFolder}/.devcontainer,type=bind,readonly"
    // "source=${localWorkspaceFolder}/.claude,target=${containerWorkspaceFolder}/.claude,type=bind,readonly"
  ],

  "postCreateCommand": "bundle install",

  "customizations": {
    "jetbrains": {
      "backend": "RubyMine"
    }
  },

  "containerEnv": {
    "BUNDLE_PATH": "/usr/local/bundle",
    "GIT_OPTIONAL_LOCKS": "0",
    "HTTPS_PROXY": "http://egress:8888",
    "HTTP_PROXY": "http://egress:8888",
    "https_proxy": "http://egress:8888",
    "http_proxy": "http://egress:8888",
    "NO_PROXY": "localhost,127.0.0.1",
    "no_proxy": "localhost,127.0.0.1",
    "NODE_USE_ENV_PROXY": "1"
  },

  "runArgs": ["--network=devnet", "--hostname=selectorgadget-dev",
              "--security-opt=no-new-privileges", "--cap-drop=NET_RAW"],

  "remoteUser": "vscode",

  "postStartCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}"
}
